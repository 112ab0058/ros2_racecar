<?xml version="1.0"?>
<package format="3">
  <name>wro2026_bringup</name>
  <version>0.1.0</version>
  <description>One-terminal launch files for the R550. sensors.launch.py: all read-only nodes (chassis feedback, lidar, URDF, read-only Foxglove bridge). localization.launch.py: sensors + robot_localization EKF.</description>
  <maintainer email="t112ab0058@ntut.org.tw">112ab0058</maintainer>
  <license>MIT</license>

  <exec_depend>wro2026_base_r550</exec_depend>
  <exec_depend>wro2026_lidar_n10p</exec_depend>
  <exec_depend>wro2026_description</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
