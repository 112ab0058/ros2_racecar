<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wro2026_control</name>
  <version>0.1.0</version>
  <description>
    Pose-free race controller (lane keeping, line-triggered corners, LiDAR
    obstacle passing, lap counting) shared by the Gazebo simulation and the
    real car.  Uses only /scan, /odom yaw and path length, /line_detection.
  </description>
  <maintainer email="t112ab0058@ntut.org.tw">Ray</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
