<?xml version="1.0"?>
<package format="3">
  <name>wro2026_sim_r550</name>
  <version>0.1.0</version>
  <description>Gazebo (Harmonic) simulation of the WHEELTEC R550 mini akm on the 160 cm field: Ackermann model with the measured dimensions, N10P-like lidar, IMU with measured noise; same ROS topics as the real car (/odom, /imu/data, /scan, /cmd_vel). Simulation only (temporary on the Orin, 2026-10-20).</description>
  <maintainer email="t112ab0058@ntut.org.tw">112ab0058</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>wro2026_base_r550</exec_depend>
  <exec_depend>wro2026_description</exec_depend>
  <exec_depend>wro2026_bringup</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
