<?xml version="1.0"?>
<!--
  WHEELTEC R550 mini akm for Gazebo Harmonic. SIMULATION ONLY.

  Frame = base_link = centre of the REAR axle at wheel height (same as the real
  URDF, src/wro2026_description/urdf/r550.urdf). x forward, y left, z up.

  Dimensions and where they come from (docs/real/R550_HARDWARE.md):
    wheelbase 0.144 m            firmware Akm_axlespacing (tape measure ~0.15)
    track 0.162 m                firmware Akm_wheelspacing
    wheel radius 0.0342 m        measured circumference 21.5 cm
    wheel width 0.028 m          measured 2026-10-20
    body: rear axle -> rear end 0.031 m, -> front end 0.24 m, width 0.18 m
    steering: firmware min turn radius 0.35 m -> centre angle atan(0.144/0.35) = 0.39 rad
    rear wheels drive, front wheels only steer (2026-10-19 air test)
    lidar at (0.13, 0, 0.115), 480 beams, 10 Hz (URDF + n10p.yaml)
    IMU at (0, 0, 0) (position UNKNOWN on the real car, same placeholder as the URDF)
  ESTIMATES (UNKNOWN on the real car): mass 2.0 kg, body height, the Orin is not modelled.
  Noise from the 2026-10-20 still tests: gyro std 0.00037 rad/s per sample, gyro z
  bias 0.0006 rad/s (so ZUPT has something to remove), lidar std 0.008 m.
-->
<sdf version="1.10">
  <model name="r550">
    <link name="base_link">
      <inertial>
        <pose>0.10 0 0.03 0 0 0</pose>
        <mass>2.0</mass>
        <inertia><ixx>0.0030</ixx><iyy>0.0128</iyy><izz>0.0146</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body">
        <pose>0.1045 0 0.03 0 0 0</pose>
        <geometry><box><size>0.271 0.12 0.06</size></box></geometry>
      </collision>
      <visual name="body">
        <pose>0.1045 0 0.03 0 0 0</pose>
        <geometry><box><size>0.271 0.12 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <!-- not "lidar": a visual and a sensor with the same name in one link crash
           gz-sim 8 (gpu_lidar render target is never created -> segfault, 2026-10-21) -->
      <visual name="lidar_visual">
        <pose>0.13 0 0.10 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0.13 0 0.115 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>480</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.270096</max_angle>
            </horizontal>
          </scan>
          <range><min>0.1</min><max>12.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.008</stddev></noise>
        </lidar>
      </sensor>

      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/sim/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00037</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00037</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00037</stddev>
              <bias_mean>0.0006</bias_mean></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- rear wheels: driven -->
    <link name="rear_left_wheel">
      <pose>0 0.081 0 -1.5707963 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.9e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>0 -0.081 0 -1.5707963 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.9e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- front: steering knuckles (servo) + free-rolling wheels -->
    <link name="front_left_steer">
      <pose>0.144 0.081 0 0 0 0</pose>
      <inertial><mass>0.02</mass>
        <inertia><ixx>2e-6</ixx><iyy>2e-6</iyy><izz>2e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper>
        <effort>1e6</effort></limit></axis>
    </joint>
    <link name="front_left_wheel">
      <pose>0.144 0.081 0 -1.5707963 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.9e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="front_right_steer">
      <pose>0.144 -0.081 0 0 0 0</pose>
      <inertial><mass>0.02</mass>
        <inertia><ixx>2e-6</ixx><iyy>2e-6</iyy><izz>2e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steer</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper>
        <effort>1e6</effort></limit></axis>
    </joint>
    <link name="front_right_wheel">
      <pose>0.144 -0.081 0 -1.5707963 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1.8e-5</ixx><iyy>1.8e-5</iyy><izz>2.9e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.0342</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!--
      Ackermann drive: /sim/cmd_vel (geometry Twist: linear.x, angular.z) -> rear wheel
      speed + steering angle. Its odometry comes from the WHEEL joints (like the real
      encoders), not from the true pose. Limits match CommandGate (r550_base.yaml).
    -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.162</kingpin_width>
      <steering_limit>0.39</steering_limit>
      <wheel_base>0.144</wheel_base>
      <wheel_separation>0.162</wheel_separation>
      <wheel_radius>0.0342</wheel_radius>
      <min_velocity>-0.15</min_velocity>
      <max_velocity>0.3</max_velocity>
      <min_acceleration>-0.5</min_acceleration>
      <max_acceleration>0.5</max_acceleration>
      <topic>/sim/cmd_vel</topic>
      <odom_topic>/sim/odom</odom_topic>
      <tf_topic>/sim/odom_tf_unused</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- TRUE pose, for checking results only (drive_test_node). Never used for control. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>r550</robot_base_frame>
      <odom_topic>/sim/ground_truth</odom_topic>
      <tf_topic>/sim/ground_truth_tf_unused</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
