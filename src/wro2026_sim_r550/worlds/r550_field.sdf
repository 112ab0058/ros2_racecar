<?xml version="1.0"?>
<!--
  The 160 x 160 cm project field (docs/sim/FIELD_PLAN_160CM.md), SIMULATION ONLY.
  Origin = field centre. Outer walls inner faces at x/y = +-0.8 m, central island
  0.4 x 0.4 m, so every lane is 0.6 m wide. Walls 0.25 m high: the height we are
  raising the real walls to (the lidar scan plane is at 0.15 m).
-->
<sdf version="1.10">
  <world name="r550_field">
    <physics name="5ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>0 0.815 0.125 0 0 0</pose>
          <geometry><box><size>1.66 0.03 0.25</size></box></geometry></collision>
        <visual name="north"><pose>0 0.815 0.125 0 0 0</pose>
          <geometry><box><size>1.66 0.03 0.25</size></box></geometry></visual>
        <collision name="south"><pose>0 -0.815 0.125 0 0 0</pose>
          <geometry><box><size>1.66 0.03 0.25</size></box></geometry></collision>
        <visual name="south"><pose>0 -0.815 0.125 0 0 0</pose>
          <geometry><box><size>1.66 0.03 0.25</size></box></geometry></visual>
        <collision name="east"><pose>0.815 0 0.125 0 0 0</pose>
          <geometry><box><size>0.03 1.6 0.25</size></box></geometry></collision>
        <visual name="east"><pose>0.815 0 0.125 0 0 0</pose>
          <geometry><box><size>0.03 1.6 0.25</size></box></geometry></visual>
        <collision name="west"><pose>-0.815 0 0.125 0 0 0</pose>
          <geometry><box><size>0.03 1.6 0.25</size></box></geometry></collision>
        <visual name="west"><pose>-0.815 0 0.125 0 0 0</pose>
          <geometry><box><size>0.03 1.6 0.25</size></box></geometry></visual>
        <collision name="island"><pose>0 0 0.125 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.25</size></box></geometry></collision>
        <visual name="island"><pose>0 0 0.125 0 0 0</pose>
          <geometry><box><size>0.4 0.4 0.25</size></box></geometry></visual>
      </link>
    </model>
    <!--
      Orange / blue turn lines, 20 mm tape (docs/sim/FIELD_PLAN_160CM.md), WRO Future Engineers
      corner layout scaled to the 160 cm field: in every corner section both lines start at the
      island corner and run to the outer wall, 0.4 m from the field centre line (slope 1:3, as
      the old wro2026_field.sdf; that copy started 9.5 cm off the island corner).
      Visual only (2 mm thin, far below the 0.115 m lidar plane): the car drives over them.
    -->
    <model name="turn_lines">
      <static>true</static>
      <link name="link">
        <visual name="orange_ne"><pose>0.3000 0.5000 0.001 0 0 1.2490</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>1.0 0.36 0 1</ambient><diffuse>1.0 0.36 0 1</diffuse></material></visual>
        <visual name="blue_ne"><pose>0.5000 0.3000 0.001 0 0 0.3218</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>0.0 0.22 1.0 1</ambient><diffuse>0.0 0.22 1.0 1</diffuse></material></visual>
        <visual name="orange_se"><pose>0.5000 -0.3000 0.001 0 0 -0.3218</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>1.0 0.36 0 1</ambient><diffuse>1.0 0.36 0 1</diffuse></material></visual>
        <visual name="blue_se"><pose>0.3000 -0.5000 0.001 0 0 -1.2490</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>0.0 0.22 1.0 1</ambient><diffuse>0.0 0.22 1.0 1</diffuse></material></visual>
        <visual name="orange_sw"><pose>-0.3000 -0.5000 0.001 0 0 -1.8925</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>1.0 0.36 0 1</ambient><diffuse>1.0 0.36 0 1</diffuse></material></visual>
        <visual name="blue_sw"><pose>-0.5000 -0.3000 0.001 0 0 -2.8198</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>0.0 0.22 1.0 1</ambient><diffuse>0.0 0.22 1.0 1</diffuse></material></visual>
        <visual name="orange_nw"><pose>-0.5000 0.3000 0.001 0 0 2.8198</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>1.0 0.36 0 1</ambient><diffuse>1.0 0.36 0 1</diffuse></material></visual>
        <visual name="blue_nw"><pose>-0.3000 0.5000 0.001 0 0 1.8925</pose>
          <geometry><box><size>0.6325 0.02 0.002</size></box></geometry>
          <material><ambient>0.0 0.22 1.0 1</ambient><diffuse>0.0 0.22 1.0 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
