<?xml version="1.0"?>
<!--
  Minimal WAVE ROVER description (transitional test car).

  Frames only: base_link (root; the base driver publishes odom -> base_link),
  imu_link (frame of /imu/data) and camera_link (placeholder).

  Every dimension below is UNKNOWN (not measured yet) unless stated
  otherwise; the values are rough placeholders so RViz shows something
  sensible. Measure and replace them (milestone H5).
-->
<robot name="wave_rover">

  <link name="base_link">
    <visual>
      <!-- body box: UNKNOWN size, placeholder 0.20 x 0.16 x 0.06 m -->
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.16 0.06"/>
      </geometry>
    </visual>
  </link>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- IMU (QMI8658 on the ESP32 board) position and axis directions UNKNOWN;
         placeholder: at base_link, axes aligned -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- camera model and mount UNKNOWN; placeholder: 0.10 m ahead, 0.10 m up -->
    <origin xyz="0.10 0 0.10" rpy="0 0 0"/>
  </joint>

</robot>
