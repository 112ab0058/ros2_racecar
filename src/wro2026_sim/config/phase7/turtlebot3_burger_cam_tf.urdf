<?xml version="1.0"?>
<!--
  Phase 7C TF-only robot description.

  The authoritative simulation geometry remains:
    models/turtlebot3_burger_cam/model.sdf

  This file deliberately contains no visual, collision, inertial, plugin, or
  transmission replacement. It only exposes the existing SDF link/joint
  frames to robot_state_publisher for passive TF inspection.
-->
<robot name="phase7_turtlebot3_burger_cam_tf">
  <link name="base_footprint"/>
  <link name="base_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="wheel_left_link"/>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.080 0.023" rpy="-1.570000 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link"/>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.080 0.023" rpy="-1.570000 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="base_scan"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.032 0 0.171" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.076 0 0.093" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
</robot>
